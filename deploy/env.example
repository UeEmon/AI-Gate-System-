# Copy to .env in this directory. Never commit .env.
GATE_DOMAIN=gate.example.com
GATE_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
AWS_REGION=ap-northeast-1
GATE_OCR_BACKEND=auto
# AWS自動デプロイは停止中。学習はローカル/手動運用で実行してください。
GATE_OCR_TRAINING_BACKEND=fast-plate-ocr
GATE_OCR_TRAINING_AUTO=1
GATE_OCR_TRAINING_MIN_SAMPLES=7
GATE_FAST_OCR_TRAIN_EPOCHS=20
GATE_FAST_OCR_TRAIN_BATCH_SIZE=8
GATE_FAST_OCR_MIN_EXACT_ACCURACY=0.80
# Lipla-jpを使用する場合は lipla に変更
GATE_FAST_ALPR_DETECTOR=yolo-v9-t-384-license-plate-end2end
GATE_FAST_OCR_MODEL=cct-xs-v2-global-model
GATE_FAST_OCR_DEVICE=cpu
GATE_FAST_OCR_MODEL_PATH=
GATE_FAST_OCR_CONFIG_PATH=
GATE_PADDLE_MODEL=PP-OCRv6_medium_rec
GATE_PLATE_MODEL=
GATE_MODEL_INIT_TIMEOUT=900
GATE_EMAIL_FROM=verified-sender@example.com
GATE_EMAIL_TO=operator@example.com
GATE_S3_BUCKET=your-private-evidence-bucket
