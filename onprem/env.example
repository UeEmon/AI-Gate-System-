GATE_ADMIN_PASSWORD=replace-with-a-long-unique-password
GATE_BIND_ADDRESS=127.0.0.1
GATE_RTMP_BIND_ADDRESS=0.0.0.0
GATE_RTMP_PORT=1935
GATE_RTMPS_BIND_ADDRESS=0.0.0.0
GATE_RTMPS_PORT=1936
GATE_BENCHMARK_PORT=8889
GATE_OFFLINE=0
GATE_VEHICLE_AI_ENABLED=1
# ChatGPT is tried first when both keys are present. Keep keys only in local .env.
GATE_OPENAI_API_KEY=
GATE_OPENAI_MODEL=gpt-4.1-mini
GATE_GEMINI_API_KEY=
GATE_GEMINI_MODEL=gemini-3.8-flash
GATE_VEHICLE_AI_TIMEOUT=20
GATE_MODEL_INIT_TIMEOUT=900
GATE_EMAIL_FROM=
GATE_EMAIL_TO=
GATE_SMTP_HOST=
GATE_SMTP_PORT=587
GATE_SMTP_TLS=starttls
GATE_SMTP_USER=
GATE_SMTP_PASSWORD=
GATE_PUBLIC_URL=http://localhost:8080

# Real validation-image optimization at startup (skips if data unavailable)
GATE_AUTO_OPTIMIZE=1
GATE_SOURCE_FPS=30
GATE_TARGET_FPS=10
# Optional immutable evaluated model publishing; token is never included in exports
GATE_MODEL_REPOSITORY=UeEmon/AI-Gate-JP-Models
GATE_MODEL_REPO_TOKEN=
GATE_MODEL_EXPORT_LICENSE=
