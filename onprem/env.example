GATE_ADMIN_PASSWORD=replace-with-a-long-unique-password
GATE_BIND_ADDRESS=127.0.0.1
GATE_BENCHMARK_PORT=8889
GATE_OFFLINE=0
GATE_MODEL_INIT_TIMEOUT=900
GATE_PLATE_PIPELINE=lipla
# 学習・評価した重みを/modelsに配置し、paddle指定時のみ有効化
GATE_PADDLE_PLATE_WEIGHTS=/models/plate.pt
GATE_PADDLE_REC_MODEL_DIR=/models/paddle-rec
GATE_PADDLE_AUTO_TRAIN=0
GATE_PADDLE_TRAIN_REPO=/training/PaddleOCR
GATE_PADDLE_PRETRAINED=/models/PP-OCRv5_mobile_rec_pretrained.pdparams
GATE_EMAIL_FROM=
GATE_EMAIL_TO=
GATE_SMTP_HOST=
GATE_SMTP_PORT=587
GATE_SMTP_TLS=starttls
GATE_SMTP_USER=
GATE_SMTP_PASSWORD=
GATE_PUBLIC_URL=http://localhost:8080
