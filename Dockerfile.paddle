FROM python:3.11-slim-bookworm
LABEL jp.ai-gate-system.cleanup-scope="onprem"
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 GATE_MODEL_ROOT=/models
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-paddle-training.txt /tmp/requirements-paddle-training.txt
RUN python -m pip install --no-cache-dir 'torch>=2.2,<3' 'torchvision>=0.17,<1' \
    --index-url https://download.pytorch.org/whl/cpu
# Official CPU index includes Linux aarch64 wheels missing from PyPI for 3.3.1.
# Keep the same Paddle version on Intel and Apple Silicon.
RUN python -m pip install --no-cache-dir 'paddlepaddle==3.3.1' \
    --extra-index-url https://www.paddlepaddle.org.cn/packages/stable/cpu/
RUN python -m pip install --no-cache-dir 'ultralytics>=8.3,<9' \
    'paddleocr>=3,<4' 'lipla-jp==0.4.1' 'Pillow>=10,<13' 'numpy>=1.26,<3'
RUN python -m pip install --no-cache-dir -r /tmp/requirements-paddle-training.txt
RUN python -c 'import paddle, skimage, lmdb, pyclipper, rapidfuzz, albumentations; print("PaddleOCR training imports OK:", paddle.__version__)'
RUN OMP_NUM_THREADS=1 python -c 'import platform, paddle, torch; paddle.set_device("cpu"); assert float(paddle.matmul(paddle.ones([2,2]), paddle.ones([2,2]))[0,0]) == 2; assert torch.ones(2,2).matmul(torch.ones(2,2))[0,0].item() == 2; print("Trainer CPU smoke OK:", platform.machine())'
RUN useradd --create-home --uid 10001 gate && mkdir /data /models && chown gate:gate /data /models
COPY --chown=gate:gate resource_lock.py app.py events.py plate_rules.py ocr_learning.py vision_train.py \
  paddle_training.py paddle_finetune.py paddle_auto_train.py paddle_auto_worker.py \
  paddle_evaluate.py paddle_plate_pipeline.py lipla_pipeline.py ./
USER gate
CMD ["python", "paddle_auto_worker.py", "--data", "/data"]
